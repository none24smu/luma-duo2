diff --git a/drivers/power/reset/reboot-mode.c b/drivers/power/reset/reboot-mode.c
index 3611bed341e1..22a9c75ee0fd 100644
--- a/drivers/power/reset/reboot-mode.c
+++ b/drivers/power/reset/reboot-mode.c
@@ -10,6 +10,7 @@
 #include <linux/list.h>
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/panic_notifier.h>
 #include <linux/property.h>
 #include <linux/reboot.h>
 #include <linux/reboot-mode.h>
@@ -101,6 +102,30 @@ static unsigned int get_reboot_mode_magic(struct reboot_mode_driver *reboot,
 	return 0;
 }
 
+/*
+ * Mode to record when the kernel panics, e.g. reboot_mode.panic_mode=bootloader.
+ * A panic restarts through emergency_restart(), which skips the reboot
+ * notifiers, so without this a panicking kernel records no mode and the
+ * bootloader starts the same kernel again. Unset by default.
+ */
+static char *panic_mode;
+module_param(panic_mode, charp, 0444);
+MODULE_PARM_DESC(panic_mode, "reboot mode to record on kernel panic");
+
+static int reboot_mode_panic(struct notifier_block *this,
+			     unsigned long event, void *ptr)
+{
+	struct reboot_mode_driver *reboot;
+	unsigned int magic;
+
+	reboot = container_of(this, struct reboot_mode_driver, panic_notifier);
+	magic = get_reboot_mode_magic(reboot, panic_mode);
+	if (magic)
+		reboot->write(reboot, magic);
+
+	return NOTIFY_DONE;
+}
+
 static int reboot_mode_notify(struct notifier_block *this,
 			      unsigned long mode, void *cmd)
 {
@@ -214,6 +239,12 @@ int reboot_mode_register(struct reboot_mode_driver *reboot)
 	reboot->reboot_notifier.notifier_call = reboot_mode_notify;
 	register_reboot_notifier(&reboot->reboot_notifier);
 
+	if (panic_mode) {
+		reboot->panic_notifier.notifier_call = reboot_mode_panic;
+		atomic_notifier_chain_register(&panic_notifier_list,
+					       &reboot->panic_notifier);
+	}
+
 	ret = reboot_mode_create_device(reboot);
 	if (ret)
 		goto error;
@@ -268,6 +299,9 @@ int reboot_mode_unregister(struct reboot_mode_driver *reboot)
 	struct mode_info *next;
 
 	unregister_reboot_notifier(&reboot->reboot_notifier);
+	if (panic_mode)
+		atomic_notifier_chain_unregister(&panic_notifier_list,
+						 &reboot->panic_notifier);
 	reboot_mode_unregister_device(reboot);
 
 	list_for_each_entry_safe(info, next, &reboot->head, list) {
diff --git a/include/linux/reboot-mode.h b/include/linux/reboot-mode.h
index 4a2abb38d1d6..5be1b664b9fa 100644
--- a/include/linux/reboot-mode.h
+++ b/include/linux/reboot-mode.h
@@ -7,6 +7,7 @@ struct reboot_mode_driver {
 	struct list_head head;
 	int (*write)(struct reboot_mode_driver *reboot, unsigned int magic);
 	struct notifier_block reboot_notifier;
+	struct notifier_block panic_notifier;
 };
 
 int reboot_mode_register(struct reboot_mode_driver *reboot);
