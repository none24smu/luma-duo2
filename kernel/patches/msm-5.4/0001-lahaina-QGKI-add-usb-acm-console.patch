--- a/arch/arm64/configs/vendor/lahaina_QGKI.config
+++ b/arch/arm64/configs/vendor/lahaina_QGKI.config
@@ -308,3 +308,25 @@
 # MSCHANGE -> enable usermode helper on path /system/bin
 CONFIG_STATIC_USERMODEHELPER_PATH="/system/bin/core_collector"
 #End MSCHANGE
+
+# Luma Duo 2 bring-up: USB console and USB network.
+# The phone has no debug UART cable, so the only console is a USB gadget. The
+# stock config has USB_CONFIGFS_ACM, but a configfs gadget has to be assembled
+# by userspace, which is exactly what bring-up is trying to debug. A legacy
+# gadget binds the first UDC by itself with no userspace at all, and
+# U_SERIAL_CONSOLE is what makes console=ttyGS0 a real console rather than
+# just a tty, replaying the printk ring buffer once the gadget binds.
+#
+# g_cdc rather than g_serial: the same ACM console plus a CDC Ethernet link.
+# On this kernel the console's receive side stops ~300 s after boot (the
+# phone keeps sending), so interactive access goes over SSH on the network
+# function and the serial port carries the kernel log.
+CONFIG_USB_CDC_COMPOSITE=y
+CONFIG_U_SERIAL=y
+CONFIG_U_SERIAL_CONSOLE=y
+
+# dummy_hcd is a software UDC + host pair for testing gadgets in loopback.
+# Built in, it registers before the real dwc3 controller, and g_serial binds
+# to the first UDC it finds -- so the console gadget attached to the phone
+# itself and never reached the USB port.
+# CONFIG_USB_DUMMY_HCD is not set
