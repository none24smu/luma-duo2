# Surface Duo 2 bring-up fragment, merged over arm64 defconfig.
#
# One rule governs this file: anything needed to produce a console must be
# built in, never a module. The phone has no debug UART cable, so the CDC-ACM
# gadget is the only way to see a boot, and a module cannot be loaded by a
# kernel that has not mounted a root filesystem yet. arm64 defconfig ships
# several of these as =m, which is why they are restated here.

# --- USB console ----------------------------------------------------------
# The legacy g_serial gadget rather than a configfs one. configfs needs
# userspace to assemble the gadget; g_serial binds the first UDC on its own,
# so it produces a console on a kernel with no userspace at all.
# U_SERIAL_CONSOLE is what makes console=ttyGS0 a real console rather than
# just a tty, and it replays the printk ring buffer once the gadget binds.
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_U_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_G_SERIAL=y

# --- USB controller and PHYs ----------------------------------------------
# usb_1 is the dwc3 at a600000, the controller Microsoft's own Android cmdline
# names. Its device tree node references both a high-speed and a QMP combo
# PHY, so both drivers must be present or dwc3 defers probe forever and the
# console never appears.
#   usb_1_hsphy  qcom,sm8350-usb-hs-phy      -> snps femto v2
#   usb_1_qmpphy qcom,sm8350-qmp-usb3-dp-phy -> qmp combo
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
# PHY_QCOM_QMP is a menuconfig wrapping "if PHY_QCOM_QMP ... endif" around
# every QMP child. arm64 defconfig leaves it =m, and a child symbol can never
# exceed its menuconfig parent, so asking for PHY_QCOM_QMP_COMBO=y on its own
# is silently downgraded back to =m by olddefconfig. The parent has to be set
# first. This cost a build cycle to find; it does not announce itself, because
# merge_config reports no conflict and the .config simply comes back wrong.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y

# --- Regulators -----------------------------------------------------------
# The PHYs draw their supplies from the RPMh regulators, so these cannot be
# modules either.
CONFIG_REGULATOR=y
CONFIG_REGULATOR_QCOM_RPMH=y

# --- Storage --------------------------------------------------------------
# Not needed for the first console-only boot, but needed the moment there is
# a root filesystem, and cheap to carry.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y

# --- Logs from before the console existed ---------------------------------
# The one answer to a silent early hang. Still needs a reserved-memory region
# in the device tree, which mainline's Duo 2 DTS does not declare yet.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# --- Bring-up verbosity ---------------------------------------------------
CONFIG_PRINTK_TIME=y
CONFIG_DYNAMIC_DEBUG=y

# --- Turned off for bring-up ----------------------------------------------
# Not required for the USB console, but dropped to keep this kernel small and
# quick to rebuild. Mainline's Duo 2 device tree describes no display at all,
# so DRM has nothing to drive, and dr_mode is hardcoded to "peripheral", so no
# Type-C role switching happens. Both come back when display bring-up starts.
# CONFIG_DRM is not set
# CONFIG_TYPEC is not set

# --- The way home -----------------------------------------------------------
# Every bring-up boot must be able to return to fastboot unattended. The ABL
# enters fastboot when the PMIC's SDAM reboot-reason byte (pmk8350 SDAM 0x7100,
# offset 0x48, bits 1-7 -- the same cell Microsoft's kernel writes) holds 0x02.
# Mainline already describes that with nvmem-reboot-mode in pmk8350.dtsi; the
# drivers just have to be built in, because the bring-up initramfs is one
# static binary and loads no modules.
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_NVMEM_REBOOT_MODE=y
# A watchdog bite resets a hard-hung kernel instead of leaving it on the logo.
CONFIG_QCOM_WDT=y
