diff --git a/patches/phoc/0008-map-touch-to-its-libinput-output.patch b/patches/phoc/0008-map-touch-to-its-libinput-output.patch
new file mode 100644
index 0000000..3ac5eb8
--- /dev/null
+++ b/patches/phoc/0008-map-touch-to-its-libinput-output.patch
@@ -0,0 +1,44 @@
+From: luma-duo2
+Subject: seat: map touchscreens to the output libinput names
+
+Touch devices are mapped to an output from GSettings (matched by EDID), else
+from wlr_touch.output_name, else to the built-in output. wlroots' libinput
+backend never fills in output_name, so a device whose udev rules assign it an
+output (WL_OUTPUT, which libinput reports as the device's output name) still
+lands on the built-in one.
+
+On the Surface Duo 2 that matters: it has one touchscreen per panel, and both
+panels report the same EDID, so neither GSettings nor the fallback can put
+each touchscreen on its own panel. Ask libinput when wlroots has no name.
+
+--- a/src/seat.c
++++ b/src/seat.c
+@@ -476,11 +476,24 @@
+ 
+   touch = wlr_touch_from_input_device (wlr_device);
+ 
+-  if (!touch->output_name)
+-    return NULL;
++  if (touch->output_name) {
++    g_debug ("Looking up output %s", touch->output_name);
++    return phoc_desktop_find_output_by_name (desktop, touch->output_name);
++  }
+ 
+-  g_debug ("Looking up output %s", touch->output_name);
+-  return phoc_desktop_find_output_by_name (desktop, touch->output_name);
++  /* wlroots' libinput backend does not fill in output_name, so ask libinput
++   * for the output udev assigned the device (the WL_OUTPUT property). */
++  if (wlr_input_device_is_libinput (wlr_device)) {
++    struct libinput_device *libinput_device = wlr_libinput_get_device_handle (wlr_device);
++    const char *output_name = libinput_device_get_output_name (libinput_device);
++
++    if (output_name) {
++      g_debug ("Looking up output %s (WL_OUTPUT)", output_name);
++      return phoc_desktop_find_output_by_name (desktop, output_name);
++    }
++  }
++
++  return NULL;
+ }
+ 
+ 
