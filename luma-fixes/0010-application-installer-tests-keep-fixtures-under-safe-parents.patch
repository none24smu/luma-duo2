+def _safe_base_dir():
+    """The home directory, or the build directory when the home sits under a
+    group- or world-writable parent (Luma's RPM builder sets HOME under /tmp):
+    the code under test rightly refuses such trees, whatever the test does."""
+    home = Path.home()
+    for member in (home, *home.parents):
+        status = member.lstat()
+        if status.st_uid not in (0, os.getuid()) or status.st_mode & 0o022:
+            return Path.cwd()
+    return home
