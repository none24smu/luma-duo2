# Surface Duo 2: Phoc composites on the Adreno 660 -- Mesa Turnip on Qualcomm
# KGSL, through wlroots' Vulkan renderer, which accepts a GPU without a DRM
# node only when asked (docs/gpu.md).
WLR_RENDERER=vulkan
WLR_VK_ALLOW_NON_DRM_DEVICE=1
VK_ICD_FILENAMES=/opt/mesa-kgsl/share/vulkan/icd.d/freedreno_icd.aarch64.json
# GTK 4 / libadwaita applications render with Vulkan on the same GPU (GL
# through Zink cannot yet find a KGSL device).
GSK_RENDERER=vulkan
