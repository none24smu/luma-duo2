# Surface Duo 2: the Adreno 660 through Qualcomm's KGSL, and the ION buffer
# allocator Mesa's Turnip uses with it (this kernel has no dma-buf heaps).
# Modes as the stock vendor ueventd.rc sets them (kgsl-3d0 0666); ION is
# granted to the active seat's user instead of Android's "system" group.
SUBSYSTEM=="kgsl", KERNEL=="kgsl-3d0", MODE="0666"
KERNEL=="ion", MODE="0660", TAG+="uaccess"
